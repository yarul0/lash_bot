BOT_TOKEN=123456:ABC-your-token
ADMIN_ID=123456789
# Час вимкнення нагадування клієнту (в хвилинах до візиту)
REMINDER_MINUTES=180
# Профіль майстра, який показується при записі
MASTER_USERNAME=@kh_sveta_lash

# Логін/пароль для входу в веб-адмінку
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Turso (хмарний SQLite) — обов'язково для деплою. Якщо не задано — локальний SQLite.
TURSO_URL=libsql://your-db-group.turso.io
TURSO_AUTH_TOKEN=eyJ...

# Webhook для Render. Якщо не задано — бот працює у режимі polling (локально).
WEBHOOK_URL=https://your-app.onrender.com
WEBHOOK_SECRET=some-random-secret
# Порт, який задає Render ($PORT). Локально використовується лише в webhook-режимі.
PORT=8080
